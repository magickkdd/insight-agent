LLM_MODEL_ID="你的模型名"
LLM_API_KEY="你的 key"
LLM_BASE_URL="https://任意 OpenAI 兼容端点/v1"
TAVILY_API_KEY="你的 Tavily key"

# ---- 可选：对抗审查层（REDTEAM_SPEC）----
# REDTEAM_ENABLED=auto          # auto=仅 deep 档启用 | true | false
# REDTEAM_MAX_ROUNDS=1          # 审查轮数预算（含首轮）：1=只审不修直接降级归档，2=打回修订一次
# REDTEAM_PROFILE=hybrid        # cloud | hybrid | local（审查走强模型）
# REDTEAM_MAX_ISSUES=10         # 单轮审查意见截断上限

LLM_MODEL_ID="你的模型名"
LLM_API_KEY="你的 key"
LLM_BASE_URL="https://任意 OpenAI 兼容端点/v1"
TAVILY_API_KEY="你的 Tavily key"

# ---- 可选：对抗审查层（REDTEAM_SPEC）----
# REDTEAM_ENABLED=auto          # auto=仅 deep 档启用 | true | false
# REDTEAM_MAX_ROUNDS=1          # 审查轮数预算（含首轮）：1=只审不修直接降级归档，2=打回修订一次
# REDTEAM_PROFILE=hybrid        # cloud | hybrid | local（审查走强模型）
# REDTEAM_MAX_ISSUES=10         # 单轮审查意见截断上限

# ---- 可选：运行台账（SCHEDULING_SPEC）----
# 每次 research 会在 RUN_LOG_DIR 落一份 <run_id>.json（给脚本读）与
# 同名 .log（给人看时间线），退出码语义见 insight_agent/exits.py。
# RUN_LOG_DIR=data/runs
#
# 单价是**可选**的：不配就只记 token，不出现金额。理由是各家各时各模型
# 的单价差着数量级，写死会产出"看起来精确、实际没人敢用"的成本数字。
# 单位是「每百万 token 美元」，例如 2.0 表示 $2 / 1M tokens。
# LLM_PRICE_PER_MTOK=0

# ---- 可选：端点不支持结构化输出时打开 ----
# 实测 Intern InkStone 科研模型平台（discovery-api.intern-ai.org.cn）传
# response_format 时两种都不work（json_schema 与 json_object 都 HTTP 200 但
# content 是空串），不传时同一提示正常返回 JSON。打开这个开关后，结构化输出
# 改成「提示词约束形状 + 代码兜底」，不依赖端点的 json_schema 支持。
# 代价：形状靠提示保证，不再由协议强制 —— 所以 nodes.py 的容错层必须开着。
# LLM_NO_STRUCTURED_OUTPUT=1
